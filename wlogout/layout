{
    "label" : "lock",
    "action" : "$HOME/.config/i3/i3lock/lock",
    "text" : "[l] Lock",
    "keybind" : "l",
    "circular": true,
}
{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "[e] Logout",
    "keybind" : "e"
    "circular": true,
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "[s] Shutdown",
    "keybind" : "s"
    "circular": true,
}
{
    "label" : "suspend",
    "action" : "systemctl suspend -i",
    "text" : "[u] Suspend",
    "keybind" : "u"
    "circular": true,
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "[r] Reboot",
    "keybind" : "r"
    "circular": true,
}
